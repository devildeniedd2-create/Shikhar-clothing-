<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shikhar Clothing | शिखर क्लोदिंग - Elegant Indian Kids & Family Wear</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;600&family=Cinzel+Decorative:wght@700&display=swap" rel="stylesheet">
  <style>
    :root {
      --gold: #d4af77;
      --saffron: #ff9933;
      --deep-red: #c8102e;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', sans-serif;
      background: #0a0a0a;
      color: #f5f5f5;
      line-height: 1.7;
    }
    header {
      position: fixed;
      top: 0;
      width: 100%;
      background: rgba(10, 10, 10, 0.96);
      backdrop-filter: blur(12px);
      z-index: 1000;
      border-bottom: 1px solid rgba(212, 175, 119, 0.15);
    }
    nav {
      max-width: 1200px;
      margin: 0 auto;
      padding: 1.2rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .logo {
      font-family: 'Cinzel Decorative', serif;
      font-size: 2.2rem;
      color: var(--gold);
      text-decoration: none;
      letter-spacing: 1px;
    }
    .nav-links {
      display: flex;
      gap: 2.2rem;
    }
    .nav-links a {
      color: #f5f5f5;
      text-decoration: none;
      font-weight: 600;
      transition: color 0.3s;
    }
    .nav-links a:hover { color: var(--gold); }

    .hero {
      height: 100vh;
      background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.75)), url('https://picsum.photos/id/237/1920/1080') center/cover no-repeat;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: white;
    }
    .hero-content h1 {
      font-family: 'Playfair Display', serif;
      font-size: 5rem;
      margin-bottom: 1.2rem;
      color: var(--gold);
      text-shadow: 0 4px 20px rgba(0,0,0,0.8);
    }
    .hero-content h2 {
      font-size: 2.2rem;
      margin-bottom: 1.5rem;
      color: var(--saffron);
    }
    .hero-content p {
      font-size: 1.4rem;
      max-width: 780px;
      margin: 0 auto 2.5rem;
      font-style: italic;
    }
    .btn {
      background: var(--gold);
      color: #0a0a0a;
      padding: 16px 50px;
      border: none;
      font-size: 1.2rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.4s;
      border-radius: 50px;
      box-shadow: 0 5px 15px rgba(212,175,119,0.3);
    }
    .btn:hover {
      background: #fff;
      transform: translateY(-4px);
      box-shadow: 0 12px 30px rgba(212,175,119,0.5);
    }

    section { padding: 120px 20px; max-width: 1240px; margin: 0 auto; }
    h2 {
      font-family: 'Playfair Display', serif;
      font-size: 3.5rem;
      text-align: center;
      margin-bottom: 3.5rem;
      color: var(--gold);
      position: relative;
    }
    h2::after {
      content: '';
      width: 120px;
      height: 3px;
      background: var(--gold);
      display: block;
      margin: 1rem auto 0;
      border-radius: 2px;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 2.5rem;
    }
    .product-card {
      background: #111;
      border-radius: 20px;
      overflow: hidden;
      transition: all 0.5s ease;
      border: 1px solid rgba(212,175,119,0.1);
    }
    .product-card:hover {
      transform: translateY(-20px);
      box-shadow: 0 25px 50px rgba(212,175,119,0.18);
      border-color: var(--gold);
    }
    .product-card img {
      width: 100%;
      height: 340px;
      object-fit: cover;
      filter: brightness(0.92);
    }
    .product-info {
      padding: 2rem;
      text-align: center;
    }
    .product-info h3 {
      font-size: 1.8rem;
      margin-bottom: 0.8rem;
      color: var(--gold);
    }
    .price {
      color: var(--saffron);
      font-size: 1.6rem;
      font-weight: 700;
      margin: 1.2rem 0;
    }
    .add-to-cart {
      background: transparent;
      border: 2px solid var(--gold);
      color: var(--gold);
      padding: 12px 40px;
      border-radius: 50px;
      cursor: pointer;
      font-weight: 600;
      transition: all 0.3s;
    }
    .add-to-cart:hover {
      background: var(--gold);
      color: #0a0a0a;
    }

    .cart-modal {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.92);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 2000;
    }
    .cart-content {
      background: #111;
      padding: 2.5rem;
      border-radius: 20px;
      max-width: 520px;
      width: 92%;
      border: 1px solid var(--gold);
    }

    footer {
      background: #000;
      text-align: center;
      padding: 4rem 2rem;
      color: #aaa;
      font-size: 0.95rem;
    }

    @media (max-width: 768px) {
      .hero-content h1 { font-size: 3.5rem; }
      .hero-content h2 { font-size: 1.8rem; }
      .nav-links { gap: 1.2rem; font-size: 0.95rem; }
    }
  </style>
</head>
<body>

  <header>
    <nav>
      <a href="#" class="logo">शिखर</a>
      <div class="nav-links">
        <a href="#home">Home</a>
        <a href="#products">Collection</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
        <a href="#" onclick="showCart()">Cart (<span id="cart-count">0</span>)</a>
      </div>
    </nav>
  </header>

  <section id="home" class="hero">
    <div class="hero-content">
      <h1>Shikhar Clothing</h1>
      <h2>शानदार भारतीय परिधान</h2>
      <p>Timeless elegance for your little ones & family — soft fabrics, vibrant traditions, perfect for festivals, ceremonies & everyday royalty. विशेष रूप से 4-5 वर्ष की बालिकाओं के लिए सुंदर डिज़ाइन।</p>
      <button class="btn" onclick="document.getElementById('products').scrollIntoView({behavior: 'smooth'})">Explore Collection</button>
    </div>
  </section>

  <section id="products">
    <h2>हमारा संग्रह</h2>
    <div class="products">

      <div class="product-card">
        <img src="https://picsum.photos/id/1018/600/600" alt="Girls Ethnic Frock">
        <div class="product-info">
          <h3>Girls' Elegant Frock / Lehenga Style</h3>
          <p>4-5 साल की राजकुमारी के लिए मुलायम कपड़ा, चमकदार रंग, त्योहारों के लिए आदर्श।</p>
          <div class="price">&#8377;799</div>
          <button class="add-to-cart" onclick="addToCart('Girls Ethnic Frock', 799)">Add to Cart</button>
        </div>
      </div>

      <div class="product-card">
        <img src="https://picsum.photos/id/1060/600/600" alt="Kurti Style Top">
        <div class="product-info">
          <h3>Premium Cotton Kurti / Top</h3>
          <p>आरामदायक रोज़मर्रा का पहनावा — बच्चे और बड़े दोनों के लिए।</p>
          <div class="price">&#8377;499</div>
          <button class="add-to-cart" onclick="addToCart('Kurti Style Top', 499)">Add to Cart</button>
        </div>
      </div>

      <div class="product-card">
        <img src="https://picsum.photos/id/1080/600/600" alt="Traditional Pants">
        <div class="product-info">
          <h3>Designer Palazzo / Salwar Style</h3>
          <p>मज़बूत और स्टाइलिश — सक्रिय बच्चों के लिए परफेक्ट।</p>
          <div class="price">&#8377;999</div>
          <button class="add-to-cart" onclick="addToCart('Palazzo / Salwar', 999)">Add to Cart</button>
        </div>
      </div>

    </div>
  </section>

  <section id="about" style="background:#111;">
    <h2>हमारे बारे में</h2>
    <p style="max-width:780px;margin:0 auto;text-align:center;font-size:1.25rem;">
      शिखर क्लोदिंग उच्च गुणवत्ता वाले, सस्ते लग्ज़री परिधान प्रदान करने के लिए समर्पित है। हम बच्चों के परिधान में विशेषज्ञ हैं — खासकर 4-5 साल की छोटी लड़कियों के लिए सुंदर, आरामदायक और पारंपरिक-आधुनिक फ्यूज़न डिज़ाइन, ताकि हर बच्चा राजकुमारी जैसा महसूस करे।
    </p>
  </section>

  <section id="contact">
    <h2>Contact Us</h2>
    <p style="text-align:center;font-size:1.3rem;">
      Email: info@shikharclothing.com<br>
      Phone: +91-1234567890
    </p>
    <p style="text-align:center;margin-top:2.5rem;color:var(--gold);">24 घंटे के अंदर जवाब • हमेशा आपके लिए ✨</p>
  </section>

  <footer>
    <p>&copy; 2026 शिखर क्लोदिंग • छोटों के लिए भारतीय शान • Crafted with love in India</p>
  </footer>

  <!-- Cart Modal -->
  <div class="cart-modal" id="cartModal">
    <div class="cart-content">
      <h3>आपकी टोकरी</h3>
      <div id="cartItems"></div>
      <p style="margin:1.8rem 0;font-size:1.4rem;">कुल: &#8377;<span id="cartTotal">0</span></p>
      <button class="btn" style="width:100%;margin-top:1.2rem;" onclick="alert('धन्यवाद! यह डेमो है — ऑर्डर सफलतापूर्वक प्लेस हो गया! 🎉')">Checkout</button>
      <button onclick="hideCart()" style="background:none;border:none;color:#aaa;margin-top:1.5rem;cursor:pointer;display:block;margin:1.5rem auto 0;">Close</button>
    </div>
  </div>

  <script>
    let cart = [];
    function addToCart(name, price) {
      cart.push({name, price});
      document.getElementById('cart-count').textContent = cart.length;
      alert(name + " को टोकरी में जोड़ा गया! 🛍️");
    }
    function showCart() {
      let itemsHTML = '';
      let total = 0;
      cart.forEach(item => {
        itemsHTML += `<p>\( {item.name} — &#8377; \){item.price}</p>`;
        total += item.price;
      });
      document.getElementById('cartItems').innerHTML = itemsHTML || '<p>आपकी टोकरी खाली है</p>';
      document.getElementById('cartTotal').textContent = total;
      document.getElementById('cartModal').style.display = 'flex';
    }
    function hideCart() {
      document.getElementById('cartModal').style.display = 'none';
    }
  </script>
</body>
</html>